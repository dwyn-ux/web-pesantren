# Salin file ini ke .env dan isi nilainya
# JANGAN commit .env ke repository

APP_NAME=Pondok Pesantren Ash-Shiddiq
APP_URL=https://ponpesashiddiq.or.id
APP_ENV=production
APP_DEBUG=false

DB_HOST=localhost
DB_NAME=ponpes_ashiddiq
DB_USER=ponpes_user
DB_PASS=ganti_dengan_password_kuat

# Opsional: email untuk kontak form
MAIL_FROM=info@ponpesashiddiq.or.id
# AI artikel (isi hanya provider yang digunakan)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Custom endpoint (opsional, untuk provider OpenAI-compatible lain)
# Bisa pakai Groq, Together, Fireworks, dll.
# URL-nya isi di form saat generate, tidak perlu di .env
