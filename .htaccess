# ============================================================
# Root .htaccess — Pondok Pesantren Ash-Shiddiq
# ============================================================

Options -Indexes
ServerSignature Off

# ── Security Headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header unset X-Powered-By
</IfModule>

# ── Proteksi File Sensitif ───────────────────────────────────
<FilesMatch "\.(env|sql|log|sh|git|htpasswd|ini|bak|swp|tmp|md)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(CLAUDE\.md|composer\.(json|lock)|package(-lock)?\.json|setup-admin\.php)$">
    Require all denied
</FilesMatch>

# setup-admin.php tidak boleh ada di production sama sekali
<Files "setup-admin.php">
    Require all denied
</Files>

# ── Proteksi Folder Internal ─────────────────────────────────
# Blokir .git walau .htaccess FilesMatch hanya cocok akhiran ekstensi
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^\.git(/|$) - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule ^config(/|$) - [F,L]
    RewriteRule ^includes(/|$) - [F,L]
    RewriteRule ^migrations(/|$) - [F,L]
    RewriteRule ^cache(/|$) - [F,L]
    RewriteRule ^logs(/|$) - [F,L]

    # ── Guard anti-judol: slug aplikasi MENANG atas direktori fisik ──
    # Hacker mengunggah folder bajakan /artikel/, /galeri/, /profil/ dll berisi
    # HTML judol statis. Karena blok -f/-d di bawah meloloskan direktori fisik,
    # folder bajakan itu membayangi router. Aturan ini WAJIB di atas blok -f/-d
    # agar request ke slug resmi selalu masuk index.php walau folder rogue ada.
    RewriteRule ^artikel/([a-z0-9\-]+)/?$ index.php?page=artikel/$1 [QSA,L]
    RewriteRule ^(profil|sekapur-sirih|artikel|psb|login|login-santri|portal-santri|profil-santri|surat-kesanggupan|dokumentasi|alumni|pendataan-alumni|dokumen-lihat|berkas-santri|upload-berkas|download-template|dokumen-santri|galeri|logout)/?$ index.php?page=$1 [QSA,L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.txt [L]

    # Favicon: layani /favicon.ico dengan favicon/logo brand (hindari 404).
    # Prioritas: favicon.svg (dedicated) → logo.svg → logo.png (upload via Pengaturan).
    RewriteCond %{DOCUMENT_ROOT}/assets/img/favicon.svg -f
    RewriteRule ^favicon\.ico$ assets/img/favicon.svg [L,T=image/svg+xml]
    RewriteCond %{DOCUMENT_ROOT}/assets/img/logo.svg -f
    RewriteRule ^favicon\.ico$ assets/img/logo.svg [L,T=image/svg+xml]
    RewriteCond %{DOCUMENT_ROOT}/assets/img/logo.png -f
    RewriteRule ^favicon\.ico$ assets/img/logo.png [L,T=image/png]

    RewriteRule ^$ index.php?page=home [L,QSA]

    RewriteRule ^(.+)$ index.php?page=$1 [QSA,L]
</IfModule>

# ── Browser Caching ──────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css   "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
